<misterromdescription>
    <name>Pairs Love</name>
    <setname>pairlove</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1991</year>
    <manufacturer>Athena / Nihon System</manufacturer>
    <category>Arcade</category>
    <rotation>vertical</rotation>

    <rom index="0" zip="pairlove.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ut2-001-001.1a" map="01"/>
            <part name="ut2-001-002.3a" map="10"/>
        </interleave>
        <part repeat="131072">00</part>
        <!-- pad to 0x100000 -->
        <part repeat="786432">00</part>
        <!-- gfx1 -->
        <part name="ut2-001-004.5j"/>
        <part name="ut2-001-005.5l"/>
        <!-- pad to 0x300000 -->
        <part repeat="1048576">00</part>
        <!-- x1snd -->
        <part name="ut2-001-003.12a"/>
    </rom>

    <!-- which game, for rtl/seta_board_cfg.sv -->
    <rom index="1"><part>07</part></rom>

    <switches default="FF,7D,00" base="0">
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coinage" bits="4,5,6,7" ids="Free Play,8 Coins/3 Credits,5 Coins/3 Credits,3 Coins/2 Credits,2 Coins/3 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,6 Coins/1 Credit,5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Demo Sounds" bits="9" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R" count="5"/>
</misterromdescription>
