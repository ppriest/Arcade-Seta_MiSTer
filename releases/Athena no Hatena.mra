<misterromdescription>
    <name>Athena no Hatena?</name>
    <setname>atehate</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1993</year>
    <manufacturer>Athena</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="0" zip="atehate.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="fs001001.evn" map="01"/>
            <part name="fs001002.odd" map="10"/>
        </interleave>
        <!-- gfx1 -->
        <part name="fs001003.gfx"/>
        <!-- x1snd -->
        <part name="fs001004.pcm"/>
    </rom>

    <!-- which game, for rtl/seta_board_cfg.sv -->
    <rom index="1"><part>06</part></rom>

    <switches default="FD,FF,00" base="0">
        <dip name="Flip Screen" bits="0" ids="On,Off"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Lives" bits="4,5" ids="2,4,5,3"/>
        <dip name="Bonus Life" bits="6,7" ids="20K Only,30K/Every 40K,20K/Every 30K,None"/>
        <dip name="Coin A" bits="8,9,10" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="11,12,13" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Demo Sounds" bits="14" ids="Off,On"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R" count="5"/>
</misterromdescription>
