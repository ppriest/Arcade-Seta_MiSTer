<misterromdescription>
    <name>Oishii Puzzle Ha Irimasenka</name>
    <setname>oisipuzl</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1993</year>
    <manufacturer>Sunsoft / Atlus</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>11</part></rom>

    <rom index="0" zip="oisipuzl.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ss1u200.v10" map="12"/>
        </interleave>
        <part repeat="524288">FF</part>
        <interleave output="16">
            <part name="ss1u201.v10" map="12"/>
        </interleave>
        <!-- pad to 0x200000 -->
        <part repeat="524288">00</part>
        <!-- gfx1 -->
        <part name="ss1u306.v10"/>
        <part name="ss1u307.v10"/>
        <part name="ss1u304.v10"/>
        <part name="ss1u305.v10"/>
        <!-- pad to 0x600000 -->
        <part repeat="2097152">00</part>
        <!-- gfx2 -->
        <interleave output="16">
            <part name="ss1u23.v10" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="ss1u24.v10" map="12"/>
        </interleave>
        <!-- pad to 0x800000 -->
        <part repeat="1048576">00</part>
        <!-- gfx3 -->
        <interleave output="16">
            <part name="ss1u25.v10" map="12"/>
        </interleave>
        <!-- pad to 0xa00000 -->
        <part repeat="1572864">00</part>
        <!-- x1snd -->
        <part name="ss1u26.v10"/>
        <part name="ss1u27.v10"/>
    </rom>

    <switches default="FF,FB,00" base="0">
        <dip name="Coin A" bits="0,1,2" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="3,4,5" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Demo Sounds" bits="10" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>
</misterromdescription>
